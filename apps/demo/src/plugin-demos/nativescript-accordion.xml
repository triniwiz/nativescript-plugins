<Page xmlns:accordion="@triniwiz/nativescript-accordion" xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="nativescript-accordion" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
  <GridLayout rows="auto, *" class="p-20">
    <WrapLayout row="0">
      <Button text="Expand All" tap="{{expandAll}}"/>
      <Button text="Collapse All" tap="{{collapseAll}}"/>
      <Button text="Select First" tap="{{selectFirst}}"/>
      <Button text="Select Last" tap="{{selectLast}}"/>
      <Button text="{{ 'allowMultiple: ' + allowMultiple }}" tap="{{toggleAllowMultiple}}"/>
    </WrapLayout>

    <accordion:Accordion row="1" height="100%" items="{{items}}" allowMultiple="{{allowMultiple}}"
                         selectedIndexes="{{selectedIndexes}}"
                         loaded="{{accordionLoaded}}"
                         itemHeaderTap="{{onItemHeaderTap}}"
                         itemContentTap="{{onItemContentTap}}">

      <accordion:Accordion.headerTemplate>
        <StackLayout  backgroundColor="green" >
          <Label text="{{headerText}}"/>
        </StackLayout>
      </accordion:Accordion.headerTemplate>


      <accordion:Accordion.itemHeaderTemplate>
        <GridLayout backgroundColor="blue">
          <Label height="100%" text="{{title}}"/>
        </GridLayout>
      </accordion:Accordion.itemHeaderTemplate>

      <accordion:Accordion.itemContentTemplate>
        <StackLayout backgroundColor="orange">
          <Image height="200" decodeWidth="200" decodeHeight="200"  src="{{image}}"/>
          <Label text="{{text}}"/>
        </StackLayout>
      </accordion:Accordion.itemContentTemplate>


      <accordion:Accordion.footerTemplate>
        <StackLayout backgroundColor="yellow">
          <Label text="{{footerText}}"/>
        </StackLayout>
      </accordion:Accordion.footerTemplate>
    </accordion:Accordion>
  </GridLayout>
</Page>
